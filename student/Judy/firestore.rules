rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /profiles/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['nickname', 'avatar', 'updatedAt'])
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() > 0
        && request.resource.data.nickname.size() <= 30;
      allow delete: if false;
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['uid', 'authorName', 'text', 'parentId', 'createdAt'])
        && request.resource.data.keys().hasOnly(['uid', 'authorName', 'text', 'parentId', 'createdAt', 'avatar'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() > 0
        && request.resource.data.authorName.size() <= 30
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && (request.resource.data.parentId == null || request.resource.data.parentId is string)
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
